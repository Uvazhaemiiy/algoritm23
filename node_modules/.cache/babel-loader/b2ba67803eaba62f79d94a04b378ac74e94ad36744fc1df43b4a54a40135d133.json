u0442\\u0435\\u0439 \\u0438 \\u043F\\u0440\\u043E\\u0431\\u043B\\u0435\\u043C, \\u0438 \\u0441\\u043F\\u043E\\u0441\\u043E\\u0431\\u043E\\u0432 \\u0438\\u0445 \\u0440\\u0435\\u0448\\u0435\\u043D\\u0438\\u044F. \",/*#__PURE__*/_jsx(\"br\",{}),/*#__PURE__*/_jsx(\"br\",{}),\"13. \\u0420\\u0430\\u0437\\u0440\\u0430\\u0431\\u043E\\u0442\\u043A\\u0430 \\u0440\\u0435\\u043A\\u043E\\u043C\\u0435\\u043D\\u0434\\u0430\\u0446\\u0438\\u0439 \\u043F\\u043E \\u0443\\u043B\\u0443\\u0447\\u0448\\u0435\\u043D\\u0438\\u044E \\u0431\\u0435\\u0437\\u043E\\u043F\\u0430\\u0441\\u043D\\u043E\\u0441\\u0442\\u0438 \\u0438 \\u044D\\u0444\\u0444\\u0435\\u043A\\u0442\\u0438\\u0432\\u043D\\u043E\\u0441\\u0442\\u0438 \\u0438\\u043D\\u0444\\u043E\\u0440\\u043C\\u0430\\u0446\\u0438\\u043E\\u043D\\u043D\\u044B\\u0445 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043C. \\u042D\\u0442\\u0438 \\u0443\\u0441\\u043B\\u0443\\u0433\\u0438 \\u043F\\u043E\\u043C\\u043E\\u0433\\u0430\\u044E\\u0442 \\u043A\\u043E\\u043C\\u043F\\u0430\\u043D\\u0438\\u044F\\u043C \\u044D\\u0444\\u0444\\u0435\\u043A\\u0442\\u0438\\u0432\\u043D\\u043E \\u0438\\u0441\\u043F\\u043E\\u043B\\u044C\\u0437\\u043E\\u0432\\u0430\\u0442\\u044C \\u043F\\u0440\\u043E\\u0433\\u0440\\u0430\\u043C\\u043C\\u043D\\u044B\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043D\\u0438\\u044F 1\\u0421, \\u0441\\u043E\\u043E\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0443\\u044F \\u0438\\u0445 \\u0431\\u0438\\u0437\\u043D\\u0435\\u0441-\\u043F\\u043E\\u0442\\u0440\\u0435\\u0431\\u043D\\u043E\\u0441\\u0442\\u044F\\u043C, \\u0430 \\u0442\\u0430\\u043A\\u0436\\u0435 \\u0434\\u0430\\u043D\\u043D\\u044B\\u0435 \\u0443\\u0441\\u043B\\u0443\\u0433\\u0438 \\u043F\\u043E\\u0437\\u0432\\u043E\\u043B\\u044F\\u044E\\u0442 \\u043F\\u043E\\u0432\\u044B\\u0448\\u0430\\u0442\\u044C \\u044D\\u043A\\u043E\\u043D\\u043E\\u043C\\u0438\\u0447\\u0435\\u0441\\u043A\\u0443\\u044E \\u044D\\u0444\\u0444\\u0435\\u043A\\u0442\\u0438\\u0432\\u043D\\u043E\\u0441\\u0442\\u044C \\u0434\\u0435\\u044F\\u0442\\u0435\\u043B\\u044C\\u043D\\u043E\\u0441\\u0442\\u0438 \\u043E\\u0440\\u0433\\u0430\\u043D\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438.\"]})})]})}),/*#__PURE__*/_jsx(\"div\",{})]});export default Blog;","map":{"version":3,"names":["SidebarLayout","jsx","_jsx","jsxs","_jsxs","Blog","children","className","width","height","fill","viewBox","role","id","x","y","patternUnits","src","alt","d"],"sources":["/Users/anton/Documents/Projects/algoritim23/src/routes/Services/Services.tsx"],"sourcesContent":["import { FC } from 'react'\nimport { SidebarLayout } from 'layouts/SidebarLayout'\n\n\n\n\nconst Blog: FC = () => (\n   <SidebarLayout>\n       <section className=\"overflow-hidden bg-gray-50 py-12 md:py-20 lg:py-4\">\n      <div className=\"relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n        <svg\n          className=\"absolute top-full right-full translate-x-1/3 -translate-y-1/4 transform lg:translate-x-1/2 xl:-translate-y-1/2\"\n          width={404}\n          height={404}\n          fill=\"none\"\n          viewBox=\"0 0 404 404\"\n          role=\"img\"\n          aria-labelledby=\"svg-workcation\"\n        >\n          <title id=\"svg-workcation\">Workcation</title>\n          <defs>\n            <pattern\n              id=\"ad119f34-7694-4c31-947f-5c9d249b21f3\"\n              x={0}\n              y={0}\n              width={20}\n              height={20}\n              patternUnits=\"userSpaceOnUse\"\n            >\n              <rect x={0} y={0} width={4} height={4} className=\"text-gray-200\" fill=\"currentColor\" />\n            </pattern>\n          </defs>\n          <rect width={404} height={404} fill=\"url(#ad119f34-7694-4c31-947f-5c9d249b21f3)\" />\n        </svg>\n\n        <div className=\"relative\">\n\n          <blockquote className=\"mt-10\">\n\n            <footer className=\"mt-8\">\n              <div className=\"md:flex md:items-center md:justify-center\">\n                <div className=\"md:flex-shrink-0\">\n                  <img\n                    className=\"mx-auto h-20 w-20 rounded-full\"\n                    src=\"/images/algoritm23-logo.svg\"\n                    alt=\"\"\n                  />\n                </div>\n                <div className=\"mt-3 text-center md:mt-0 md:ml-4 md:flex md:items-center\">\n                  <div className=\"text-base font-medium text-gray-900\"> IT-компания АЛГОРИТМ 23</div>\n\n                  <svg className=\"mx-1 hidden h-5 w-5 text-sky-600 md:block\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                    <path d=\"M11 0h3L9 20H6l5-20z\" />\n                  </svg>\n\n                  <div className=\"text-base font-medium text-gray-500\">Наши услуги</div>\n                </div>\n              </div>\n            </footer>\n          </blockquote>\n        </div>\n        <div className=\"mt-8 mx-auto max-w-3xl text-center text-2xl font-medium leading-9 text-gray-900\">\n              <p>\n              IT-компания АЛГОРИТМ 23, специализирующаяся на работе с платформой 1С, предоставляет различные услуги, связанные с консультацией, обучением, настройкой, внедрением, доработкой, разработкой, сопровождением, оптимизацией и модификацией программных решений на платформе 1С. <br /><br />\n              1.\tКонсультация по программным продуктам 1С: \nОказание консультационной поддержки по текущим конфигурациям используемых у Заказчика. <br /><br />\n\n2.\tВнедрение и настройка 1С:\n\nУстановка и настройка программных продуктов 1С с учетом потребностей клиента.\nСоздание баз данных и настройка пользовательских ролей, разграничение прав доступа пользователей, настройка первоначальных данных для работы с информационной системой на платформе 1С. <br /><br />\n\n3.\tРазработка и модификация конфигураций:\nРазработка конфигураций с нуля на платформе 1С с использованием языков программирования.<br /><br />\n\n4.\tДоработка конфигураций на платформе 1С. \n\nДоработка существующих конфигураций 1С в соответствии с функциональными требованиями Заказчика.\nРазработка дополнительных отчетов, обработок, форм и функциональных модулей.<br /><br />\n\n\n5.\tОптимизация кода программных продуктов. \nПовышение работоспособности программного продукта на платформе 1С, с помощью оптимизации программного кода. <br /><br />\n\n6.\tОбучение персонала:\nПроведение тренингов и обучения сотрудников по работе с программами на платформе 1С.\nРазработка обучающих материалов, руководств пользователей, инструкций, программ и методик испытаний и иной обучающей документации.<br /><br />\n\n7.\tСопровождение и техническая поддержка:\n\nПредоставление технической поддержки по вопросам использования конфигурации 1С.\nОперативное решение технических проблем, ошибок, консультация пользователей.<br /><br />\n\n8.\tМиграция данных:\n\tПеренос данных из исторических систем в конфигурации на платформе 1С.\nОбеспечение корректности и целостности данных в процессе миграции.\nОптимизация процессов.<br /><br />\n\n9.\tАнализ бизнес-процессов и предложение методов оптимизации с использованием 1С.\nВнедрение изменений для повышения работы деятельности компании. <br /><br />\n\n10.\tИнтеграция с другими информационными системами:\n\nИнтеграция программных продуктов 1С с другими информационными системами компании, в том числе разработка сайта компании и интеграция ее с информационной системой 1С.<br /><br />\n\n11.\tОбеспечение совместной работы 1С с внешними приложениями и сервисами.<br /><br />\n\n12.\tАудит информационной структуры и информационных систем компании:\n\nПроведение аудита информационных систем организации в том числе конфигураций на платформе 1С, для выявления потенциальных уязвимостей и проблем, и способов их решения. <br /><br />\n\n13.\tРазработка рекомендаций по улучшению безопасности и эффективности информационных систем.\n\nЭти услуги помогают компаниям эффективно использовать программные решения 1С, соответствуя их бизнес-потребностям, а также данные услуги позволяют повышать экономическую эффективность деятельности организации. \n\n              </p>\n            </div>\n      </div>\n    </section>\n   \n <div>\n\n </div>\n\n   </SidebarLayout>\n)\n\nexport default Blog\n"],"mappings":"AACA,OAASA,aAAa,KAAQ,uBAAuB,QAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAKrD,KAAM,CAAAC,IAAQ,CAAGA,CAAA,gBACdD,KAAA,CAACJ,aAAa,EAAAM,QAAA,eACVJ,IAAA,YAASK,SAAS,CAAC,mDAAmD,CAAAD,QAAA,cACvEF,KAAA,QAAKG,SAAS,CAAC,iDAAiD,CAAAD,QAAA,eAC9DF,KAAA,QACEG,SAAS,CAAC,gHAAgH,CAC1HC,KAAK,CAAE,GAAI,CACXC,MAAM,CAAE,GAAI,CACZC,IAAI,CAAC,MAAM,CACXC,OAAO,CAAC,aAAa,CACrBC,IAAI,CAAC,KAAK,CACV,kBAAgB,gBAAgB,CAAAN,QAAA,eAEhCJ,IAAA,UAAOW,EAAE,CAAC,gBAAgB,CAAAP,QAAA,CAAC,YAAU,CAAO,CAAC,cAC7CJ,IAAA,SAAAI,QAAA,cACEJ,IAAA,YACEW,EAAE,CAAC,sCAAsC,CACzCC,CAAC,CAAE,CAAE,CACLC,CAAC,CAAE,CAAE,CACLP,KAAK,CAAE,EAAG,CACVC,MAAM,CAAE,EAAG,CACXO,YAAY,CAAC,gBAAgB,CAAAV,QAAA,cAE7BJ,IAAA,SAAMY,CAAC,CAAE,CAAE,CAACC,CAAC,CAAE,CAAE,CAACP,KAAK,CAAE,CAAE,CAACC,MAAM,CAAE,CAAE,CAACF,SAAS,CAAC,eAAe,CAACG,IAAI,CAAC,cAAc,CAAE,CAAC,CAChF,CAAC,CACN,CAAC,cACPR,IAAA,SAAMM,KAAK,CAAE,GAAI,CAACC,MAAM,CAAE,GAAI,CAACC,IAAI,CAAC,4CAA4C,CAAE,CAAC,EAChF,CAAC,cAENR,IAAA,QAAKK,SAAS,CAAC,UAAU,CAAAD,QAAA,cAEvBJ,IAAA,eAAYK,SAAS,CAAC,OAAO,CAAAD,QAAA,cAE3BJ,IAAA,WAAQK,SAAS,CAAC,MAAM,CAAAD,QAAA,cACtBF,KAAA,QAAKG,SAAS,CAAC,2CAA2C,CAAAD,QAAA,eACxDJ,IAAA,QAAKK,SAAS,CAAC,kBAAkB,CAAAD,QAAA,cAC/BJ,IAAA,QACEK,SAAS,CAAC,gCAAgC,CAC1CU,GAAG,CAAC,6BAA6B,CACjCC,GAAG,CAAC,EAAE,CACP,CAAC,CACC,CAAC,cACNd,KAAA,QAAKG,SAAS,CAAC,0DAA0D,CAAAD,QAAA,eACvEJ,IAAA,QAAKK,SAAS,CAAC,qCAAqC,CAAAD,QAAA,CAAC,0GAAwB,CAAK,CAAC,cAEnFJ,IAAA,QAAKK,SAAS,CAAC,2CAA2C,CAACG,IAAI,CAAC,cAAc,CAACC,OAAO,CAAC,WAAW,CAAAL,QAAA,cAChGJ,IAAA,SAAMiB,CAAC,CAAC,sBAAsB,CAAE,CAAC,CAC9B,CAAC,cAENjB,IAAA,QAAKK,SAAS,CAAC,qCAAqC,CAAAD,QAAA,CAAC,+DAAW,CAAK,CAAC,EACnE,CAAC,EACH,CAAC,CACA,CAAC,CACC,CAAC,CACV,CAAC,cACNJ,IAAA,QAAKK,SAAS,CAAC,iFAAiF,CAAAD,QAAA,cAC1FF,KAAA,MAAAE,QAAA,EAAG,i3CAC4Q,cAAAJ,IAAA,QAAK,CAAC,cAAAA,IAAA,QAAK,CAAC,urBAElN,cAAAA,IAAA,QAAK,CAAC,cAAAA,IAAA,QAAK,CAAC,0+CAKqF,cAAAA,IAAA,QAAK,CAAC,cAAAA,IAAA,QA